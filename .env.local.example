# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only secrets — never add NEXT_PUBLIC_ to these names and never commit
# real values. The service-role key is used only by protected Route Handlers
# so the supervisor can create/reset student name + code accounts.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# A long random owner-only key (at least 16 characters) used once on /setup
# to create the first supervisor. Do not use the supervisor's access code here.
SUPERVISOR_SETUP_SECRET=CHOOSE-A-LONG-RANDOM-SETUP-KEY
